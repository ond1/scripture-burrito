{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://burrito.bible/schema/derived_metadata.schema.json",
    "$$target": "derived_metadata.schema.json",
    "title": "Metadata (Derived)",
    "type": "object",
    "description": "Root schema for derived burritos (meta.category = 'derived'). Derived burritos are produced from one or more source burritos — examples include back-translations, published editions, and study Bible additions.",
    "properties": {
        "format": {
            "type": "string",
            "enum": ["scripture burrito"]
        },
        "meta": {
            "$ref": "derived_meta.schema.json"
        },
        "idAuthorities": {
            "$ref": "id_authorities.schema.json"
        },
        "identification": {
            "$ref": "identification.schema.json"
        },
        "confidential": {
            "$ref": "confidential.schema.json"
        },
        "type": {
            "$ref": "type.schema.json"
        },
        "relationships": {
            "$ref": "relationships.schema.json"
        },
        "languages": {
            "$ref": "languages.schema.json"
        },
        "targetAreas": {
            "$ref": "target_areas.schema.json"
        },
        "agencies": {
            "$ref": "agencies.schema.json"
        },
        "copyright": {
            "$ref": "copyright.schema.json"
        },
        "ingredients": {
            "$ref": "ingredients.schema.json"
        },
        "localizedNames": {
            "$ref": "localized_names.schema.json"
        },
        "recipe": {
            "$comment": "recipe is from an unimplemented 'ecosystem servers' concept where a server would process a list of operations to deliver derived content. It is retained as an optional field for backwards compatibility but is not required. See https://github.com/bible-technology/scripture-burrito/issues/345",
            "$ref": "recipe.schema.json"
        }
    },
    "required": ["format", "meta", "idAuthorities", "identification", "confidential", "copyright", "type"],
    "additionalProperties": false,
    "allOf": [
        {
            "$comment": "languages is required for scripture burritos. See https://github.com/bible-technology/scripture-burrito/issues/343 for the bug this fixes.",
            "if": {
                "properties": {
                    "type": {
                        "type": "object",
                        "properties": {
                            "flavorType": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "enum": ["scripture"]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "then": {
                "required": ["languages"]
            }
        },
        {
            "$comment": "Requires a rightsHolder agency when content is not public domain. Was missing from derived_metadata — see https://github.com/bible-technology/scripture-burrito/issues/344",
            "$ref": "copyright_constraints.schema.json"
        }
    ]
}
