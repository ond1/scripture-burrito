{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://burrito.bible/schema/metadata.schema.json",
    "$$target": "metadata.schema.json",
    "title": "Metadata",
    "type": "object",
    "description": "Scripture Burrito root metadata object. The required fields and constraints depend on meta.category: 'source' burritos are validated against source_metadata, 'derived' burritos against derived_metadata, and 'template' burritos against template_metadata.",
    "properties": {
        "meta": {
            "type": "object",
            "properties": {
                "category": {
                    "enum": ["source", "derived", "template"]
                }
            }
        }
    },
    "if": {
        "description": "Condition: meta.category is 'source'",
        "properties": {
            "meta": {
                "type": "object",
                "properties": {
                    "category": {
                        "const": "source"
                    }
                }
            }
        }
    },
    "then": {
        "description": "Then (meta.category is 'source'): validate against source_metadata.",
        "$ref": "source_metadata.schema.json"
    },
    "else": {
        "if": {
            "description": "Condition: meta.category is 'derived'",
            "properties": {
                "meta": {
                    "type": "object",
                    "properties": {
                        "category": {
                            "const": "derived"
                        }
                    }
                }
            }
        },
        "then": {
            "description": "Then (meta.category is 'derived'): validate against derived_metadata.",
            "$ref": "derived_metadata.schema.json"
        },
        "else": {
            "description": "Else (meta.category is 'template'): validate against template_metadata.",
            "$ref": "template_metadata.schema.json"
        }
    }
}
