{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://burrito.bible/schema/type.schema.json",
    "$$target": "type.schema.json",
    "title": "Type",
    "description": "Contains properties describing the burrito flavor type.",
    "type": "object",
    "properties": {
        "flavorType": {
            "type": "object",
            "$comment": "The extra level of nesting (type.flavorType rather than type directly) is historical. In practice, 'type' contains only 'flavorType' and nothing else. Flattening this would be a breaking change to all existing burrito files. See https://github.com/bible-technology/scripture-burrito/issues/342 for discussion.",
            "oneOf": [
                {
                    "description": "Scripture text translation (USFM, USX, or USJ).",
                    "properties": {
                        "name": { "const": "scripture" },
                        "flavor": { "$ref": "scripture/text_translation.schema.json" },
                        "currentScope": { "$ref": "scope.schema.json" }
                    },
                    "required": ["name", "flavor", "currentScope"],
                    "additionalProperties": false
                },
                {
                    "description": "Scripture audio translation.",
                    "properties": {
                        "name": { "const": "scripture" },
                        "flavor": { "$ref": "scripture/audio_translation.schema.json" },
                        "currentScope": { "$ref": "scope.schema.json" }
                    },
                    "required": ["name", "flavor", "currentScope"],
                    "additionalProperties": false
                },
                {
                    "description": "Custom scripture flavor using the x- prefix.",
                    "properties": {
                        "name": { "const": "scripture" },
                        "flavor": { "$ref": "x_flavor.schema.json" },
                        "currentScope": { "$ref": "scope.schema.json" }
                    },
                    "required": ["name", "flavor", "currentScope"],
                    "additionalProperties": false
                },
                {
                    "description": "Gloss flavor — no standard flavor is defined; extensions must use the x- prefix.",
                    "$comment": "gloss, parascriptural, and peripheral are valid flavor type names for extensions but have no standard flavors defined. They are reserved names from an earlier design phase.",
                    "properties": {
                        "name": { "const": "gloss" },
                        "flavor": { "$ref": "x_flavor.schema.json" },
                        "currentScope": { "$ref": "scope.schema.json" }
                    },
                    "required": ["name", "flavor", "currentScope"],
                    "additionalProperties": false
                },
                {
                    "description": "Alignment flavor — word-level or timecode alignment between two texts or between text and audio. currentScope is not required; alignment files record their own reference coverage internally.",
                    "properties": {
                        "name": { "const": "alignment" },
                        "flavor": { "$ref": "alignment/alignment.schema.json" },
                        "currentScope": { "$ref": "scope.schema.json" }
                    },
                    "required": ["name", "flavor"],
                    "additionalProperties": false
                },
                {
                    "description": "Parascriptural flavor — no standard flavor is defined; extensions must use the x- prefix.",
                    "properties": {
                        "name": { "const": "parascriptural" },
                        "flavor": { "$ref": "x_flavor.schema.json" },
                        "currentScope": { "$ref": "scope.schema.json" }
                    },
                    "required": ["name", "flavor"],
                    "additionalProperties": false
                },
                {
                    "description": "Peripheral flavor — no standard flavor is defined; extensions must use the x- prefix.",
                    "properties": {
                        "name": { "const": "peripheral" },
                        "flavor": { "$ref": "x_flavor.schema.json" },
                        "currentScope": { "$ref": "scope.schema.json" }
                    },
                    "required": ["name", "flavor"],
                    "additionalProperties": false
                }
            ]
        }
    }
}
